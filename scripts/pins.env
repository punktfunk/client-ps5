# Every pin the PS5 build depends on, in one place. docs/pins.md says what each is for.
# The Rust toolchain (rust-toolchain.toml carries the same value).
RUST_NIGHTLY=nightly-2026-08-11
# The three shared crates (Cargo.toml carries the same rev).
PUNKTFUNK_REV=12e4dfd1ba7855d0043a15c2939fc923a85771ef
# PS5_Vulkan: the RADV link recipe, the title CRT, ps5-native-tool, libc.prx.
PS5_VULKAN_REPO=https://github.com/mihawk-99/PS5_Vulkan.git
PS5_VULKAN_REV=f410e67a0241b3e8edcdbcd2a9b285dfc4a412ed
# Mesa: PS5_Vulkan's pin plus HDR10 swapchains and 119.88 Hz kept under VRR (the hdr10 branch).
PS5_MESA_REPO=https://github.com/KrisEnigma/PS5_Mesa.git
PS5_MESA_REV=c90ea0aab704d48ec8d44200b2bbc5e4e42e1d51
# The payload-SDK fork (the platform layer), at the revision PS5_Vulkan pins.
PS5_SDK_REPO=https://github.com/mihawk-99/PS5_PayloadSDK.git
PS5_SDK_REV=b83202be73e930050e00de0f1b4d9ec46c0391bf
# skia-safe, matching pf-console-ui; the PS5 archive is built by scripts/build-skia.sh.
SKIA_SAFE=0.153.3
# The skia-bindings crate's own revision (its .cargo_vcs_info.json): the first half of the key a
# build looks its archive up by.
SKIA_BINARIES_HASH=b7f043e0b1e2a850e702
